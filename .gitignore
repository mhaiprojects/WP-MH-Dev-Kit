# Ignore everything by default
/*

# Project meta
!/.gitignore
!/README.md

# Documentation
!/docs/
!/docs/**

# Setup scripts (optional helper, not WP core)
!/scripts/
!/scripts/**

# Test results (SUMMARY, junit, per-module reports; logs gitignored under test-results/)
!/test-results/
!/test-results/**

# DDev config (minimal — no generated local state)
!/.ddev/
/.ddev/*
!/.ddev/config.yaml

# Custom code only
!/wp-content/
/wp-content/*
!/wp-content/mu-plugins/
!/wp-content/mu-plugins/adamat-divi-hero.php
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/mh-dev-kit/
!/wp-content/plugins/mh-dev-kit/**
