{
	"name": "mh/dev-kit",
	"description": "MH Dev Kit — monolithic WordPress development plugin",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"roots/acorn": "^5.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"MH\\DevKit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MH\\DevKit\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:unit": "phpunit --testsuite Unit",
		"test:integration": "phpunit --testsuite Integration"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"yoast/phpunit-polyfills": true
		}
	}
}
