{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mh-dev-kit/web-links",
	"title": "Web Links",
	"category": "mhdk",
	"icon": "admin-links",
	"description": "List published Web Link posts.",
	"textdomain": "mh-dev-kit",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 6
		},
		"layout": {
			"type": "string",
			"default": "list",
			"enum": ["list", "grid"]
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php"
}
