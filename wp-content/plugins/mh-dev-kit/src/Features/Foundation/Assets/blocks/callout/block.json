{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mh-dev-kit/callout",
	"title": "MH Callout",
	"category": "mh-dev-kit",
	"icon": "megaphone",
	"description": "Styled callout box with title and content.",
	"textdomain": "mh-dev-kit",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": "info",
			"enum": ["info", "warning", "success"]
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php"
}
